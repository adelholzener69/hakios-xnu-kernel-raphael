# HakiOS fragment: the Redmi K20 Pro / Mi 9T Pro (raphael) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="raphael"
CONFIG_HAKIOS_ADSP=y
CONFIG_HAKIOS_SPEAKER=y
CONFIG_HAKIOS_SOUND=y
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_SOCINFO is not set
CONFIG_HAKIOS_ADRENO=y
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
CONFIG_HAKIOS_BUTTONS=y
CONFIG_HAKIOS_QMI=y
CONFIG_HAKIOS_MODEM=y
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_CPUFREQ=y
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
CONFIG_HAKIOS_UFS=y
CONFIG_HAKIOS_WIFI=y
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_FIRMWARE is "device" in the common kernel: say "none" here until this device's firmware is pulled
CONFIG_HAKIOS_RAPHAEL_AUDIO=y
