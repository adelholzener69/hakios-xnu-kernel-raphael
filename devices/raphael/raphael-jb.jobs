# A RAM session with the package manager (Sileo, Procursus under /var/jb) for a person to use; build the image with JB=1
# (tools/mk-jb.sh fetches the prefix first). Nothing is pressed by a script: the once-per-boot preparation, the network, a fresh
# index, and the phone is yours. What is installed lives in memory like all of /private/var and is gone at the next boot.
/redwood/bin/sound_test springboard
/var/jb/bin/sh /var/jb/prep.sh
/redwood/bin/net_test waitaddr en0 60 resolve apt.procurs.us
/var/jb/usr/bin/apt-get update
