# drivers/haptic/conf: the vibration motor.
# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

driver HAPTIC
	file    bsd/dev/hakios.haptic.c
	help    the vibration motor: an Awinic AW86927 driving a linear resonant actuator (haptic=N), its waveforms
	help    from fw-haptic/

driver RAPHAEL_HAPTIC
	file    bsd/dev/hakios.raphael_haptic.c
	default n
	help    the Redmi K20 Pro's vibration motor: the PM8150B's haptics block driving an ERM (haptic=N). The same
	help    /dev/hakios-haptic as HAPTIC (redwood's Awinic chip): a kernel builds one of the two, never both
